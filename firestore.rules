rules_version = '2';

// Bufalotek Center — Firestore Security Rules
//
// Roller:
//   - admin: custom claim "admin" VEYA users/{uid}.role == "admin"
//   - departman başkanı: departments/{departmentId}.presidentUid
//   - user:  giriş yapmış her kullanıcı
//
// İlk admin'i tanımlamak için (Firebase Console):
//   1. Authentication > Users > ilgili kullanıcı > Custom claims = { "role": "admin" }
//      VEYA
//   2. Firestore > users koleksiyonu > ilgili uid dokümanı > role: "admin"

service cloud.firestore {
  match /databases/{database}/documents {

    // ---------- YARDIMCI FONKSİYONLAR ----------
    function isSignedIn() {
      return request.auth != null;
    }

    function uid() {
      return request.auth.uid;
    }

    function isAdmin() {
      return isSignedIn() && (
        request.auth.token.role == 'admin'
        || (exists(/databases/$(database)/documents/users/$(uid()))
            && get(/databases/$(database)/documents/users/$(uid())).data.role == 'admin')
      );
    }

    function isDepartmentChair(departmentId) {
      return isSignedIn()
        && exists(/databases/$(database)/documents/departments/$(departmentId))
        && get(/databases/$(database)/documents/departments/$(departmentId)).data.presidentUid == uid();
    }

    function isUser() {
      return isSignedIn();
    }

    // ---------- USERS ----------
    match /users/{userId} {
      allow read: if isSignedIn();
      allow create: if isSignedIn()
                    && uid() == userId
                    && request.resource.data.role == 'user';
      allow update: if isAdmin()
                    || (isSignedIn() && uid() == userId
                        && !('role' in request.resource.data.diff(resource.data).affectedKeys()));
      allow delete: if isAdmin();
    }

    // ---------- MEMBERS ----------
    match /members/{memberId} {
      allow read: if isUser();
      allow create: if isAdmin()
                    || (isSignedIn()
                        && uid() == memberId
                        && exists(/databases/$(database)/documents/users/$(uid())));
      allow update, delete: if isAdmin();
    }

    // ---------- MEETINGS ----------
    match /meetings/{meetingId} {
      allow read: if isUser();
      allow create: if isAdmin() || isLogTutucuForDate(request.resource.data.date);
      allow update: if isAdmin() || isLogTutucuForMeetingDate();
      allow delete: if isAdmin();
    }

    // ---------- ATTENDANCE ----------
    match /attendance/{aid} {
      allow read: if isUser();
      allow create, update, delete: if isAdmin();
    }

    // ---------- GREY LIST ----------
    match /greyList/{memberId} {
      allow read: if isUser();
      allow write: if isAdmin();
    }

    // ---------- LOG PERMISSIONS ----------
    match /logPermissions/{permId} {
      allow read: if isUser();
      allow create, update, delete: if isAdmin();
    }

    // ---------- CONFIG ----------
    match /config/{docId} {
      allow read: if isUser();
      allow write: if isAdmin();
    }

    // ---------- DEPARTMENTS ----------
    match /departments/{docId} {
      allow read: if isUser();
      allow write: if isAdmin();
    }

    // ---------- PROJECTS ----------
    match /projects/{docId} {
      allow read: if isUser();
      allow create: if isAdmin()
                    || (request.resource.data.departmentId is string
                        && isDepartmentChair(request.resource.data.departmentId));
      allow update: if isAdmin()
                    || (isDepartmentChair(resource.data.departmentId)
                        && request.resource.data.departmentId == resource.data.departmentId);
      allow delete: if isAdmin() || isDepartmentChair(resource.data.departmentId);
    }

    // ---------- USER DEPARTMENTS ----------
    match /userDepartments/{docId} {
      allow read: if isUser();
      allow create: if isAdmin()
                    || (request.resource.data.uid is string
                        && request.resource.data.departmentId is string
                        && docId == request.resource.data.uid + '_' + request.resource.data.departmentId
                        && exists(/databases/$(database)/documents/users/$(request.resource.data.uid))
                        && isDepartmentChair(request.resource.data.departmentId));
      allow update: if isAdmin();
      allow delete: if isAdmin() || isDepartmentChair(resource.data.departmentId);
    }

    // ---------- USER PROJECTS ----------
    match /userProjects/{docId} {
      allow read: if isUser();
      allow create: if isSignedIn() && uid() == request.resource.data.uid;
      allow update, delete: if isAdmin()
                            || (isSignedIn() && uid() == resource.data.uid);
    }

    // ---------- TASKS ----------
    match /tasks/{docId} {
      allow read: if isUser();
      allow create: if isSignedIn() && uid() == request.resource.data.userId;
      allow update: if isSignedIn() && (uid() == resource.data.userId || isAdmin());
      allow delete: if isAdmin() || (isSignedIn() && uid() == resource.data.userId);
    }

    // ---------- BUGUNUN LOG TUTUCUSU MU? ----------
    function isLogTutucuForDate(dateStr) {
      return isSignedIn()
        && exists(/databases/$(database)/documents/logPermissions/$(uid() + '_' + dateStr));
    }

    function isLogTutucuForMeetingDate() {
      return isSignedIn() && (
        isLogTutucuForDate(request.resource.data.date) ||
        isLogTutucuForDate(resource.data.date)
      );
    }
  }
}
